{
  "kind": "marinara.personal-extension",
  "version": 1,
  "config": {
    "name": "User Phone",
    "version": "0.6.0",
    "description": "{{user}}의 스마트폰. 전화, 문자, 톡, 카메라, 갤러리, 인터넷, 캘린더, 지도, 음악, 날씨, 시계, SNS, 그리고 새로 오픈한 AI 컴패니언 서비스 '루미'. 루미의 캐릭터는 점점 폰을 장악해 간다.",
    "runtime": "client",
    "capabilities": ["full_page_access"],
    "jsPath": [
      "src/core.js",
      "src/prompts.js",
      "src/shell.js",
      "src/apps/lumi.js",
      "src/apps/phone.js",
      "src/apps/messages.js",
      "src/apps/camera.js",
      "src/apps/memo.js",
      "src/apps/browser.js",
      "src/apps/calendar.js",
      "src/apps/maps.js",
      "src/apps/music.js",
      "src/apps/weather.js",
      "src/apps/clock.js",
      "src/apps/feed.js",
      "src/apps/settings.js",
      "src/main.js"
    ],
    "cssPath": "extension.css"
  }
}
